rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Вспомогательные функции ────────────────────────────────────────────────

    /**
     * Резолвит businessId пользователя через Firestore users/{uid}.
     * uid ≠ businessId — один тенант может иметь нескольких сотрудников.
     * Для добавления сотрудника: users/{newUid}.businessId = тот же businessId.
     */
    function userBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }

    /** Пользователь аутентифицирован и принадлежит тенанту. */
    function belongsTo(businessId) {
      return request.auth != null && userBusinessId() == businessId;
    }

    /**
     * Владелец: role = "owner" в users/{uid}.
     */
    function isOwner(businessId) {
      return belongsTo(businessId)
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
    }

    /**
     * Менеджер: role = "manager" в токене.
     * Путь для команды открыт: добавить сотрудника = создать users/{newUid}
     * с тем же businessId и role:"manager", затем выставить custom claim role через workers.
     */
    function isManager(businessId) {
      return belongsTo(businessId)
          && "role" in request.auth.token
          && request.auth.token.role == "manager";
    }

    // ── Тенантные данные ───────────────────────────────────────────────────────

    // Владелец читает всё своего тенанта.
    match /tenants/{businessId}/{document=**} {
      allow read: if isOwner(businessId);
      allow write: if false; // только CF Workers через admin SDK
    }

    // ── Густорико — сотрудники по email ───────────────────────────────────────

    // Вспомогательная функция: пользователь является сотрудником Густорико.
    // Проверяет наличие его email в коллекции emailRoles.
    function isGustorikoEmployee() {
      return request.auth != null
          && exists(/databases/$(database)/documents/tenants/gustoriko/emailRoles/$(request.auth.token.email));
    }

    // СПб менеджер — ограниченный доступ: только заказы/клиенты/финансы/долги своего региона.
    // Поставщики, прайс, сборка, закупки — недоступны.
    function isSpbManager() {
      return isGustorikoEmployee()
          && get(/databases/$(database)/documents/tenants/gustoriko/emailRoles/$(request.auth.token.email)).data.roleId == "spb_manager";
    }

    // Читать свою роль — только по совпадению email.
    match /tenants/gustoriko/emailRoles/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }

    // Заказы, клиенты, наряды, прайсы — любой сотрудник Густорико.
    match /tenants/gustoriko/orders/{orderId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/clients/{clientId} {
      allow read: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/client_contacts/{docId} {
      allow read, write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/purchase_orders/{poId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/pricelist_items/{itemId} {
      allow read: if isGustorikoEmployee() && !isSpbManager();
    }
    match /tenants/gustoriko/suppliers/{supId} {
      // spb_manager читает для combobox в StockTab; пишет только для добавления нового поставщика оттуда
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/invoices/{invId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/payments/{payId} {
      allow read: if isGustorikoEmployee();
      // Создаёт импорт банковской выписки в FinanceView (id = детерминированный txId) или VPS.
      // Сотрудник может обновить orderId/status для ручного сопоставления. Удаление — нет.
      allow create: if isGustorikoEmployee() && isValidPayment(request.resource.data);
      allow update: if isGustorikoEmployee()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["orderId", "status"]);
      allow delete: if false;
    }
    function isValidPayment(d) {
      return d.keys().hasOnly(["txId", "amount", "payerName", "payerInn", "purpose", "txDate", "orderId", "status", "createdAt"])
          && d.keys().hasAll(["txId", "amount", "payerName", "payerInn", "purpose", "txDate", "orderId", "status", "createdAt"])
          && d.txId is string
          && d.amount is int && d.amount > 0
          && d.payerName is string
          && d.payerInn is string
          && d.purpose is string
          && d.txDate is string
          && (d.orderId == null || d.orderId is string)
          && d.status in ["matched", "unmatched"]
          && d.createdAt is string;
    }
    // Рассылки: {id} — запись-журнал (status sending → sent/failed), {id}_{n} — письмо получателю.
    match /tenants/gustoriko/mailings/{docId} {
      allow read, create: if isGustorikoEmployee();
      allow update: if isGustorikoEmployee()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "error", "finishedAt"]);
      allow delete: if false;
    }
    match /tenants/gustoriko/assembly/{docId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/stock/{docId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/purchase_lines/{docId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/debts/{docId} {
      allow read: if isGustorikoEmployee();
      allow write: if isGustorikoEmployee();
    }
    match /tenants/gustoriko/chat/{msgId} {
      allow read: if isGustorikoEmployee();
      allow create: if isGustorikoEmployee();
      allow update, delete: if false;
    }

    // Менеджер читает сделки только с совпадающим ownerId.
    // crmUserId — UUID менеджера в CRM, задаётся auth-воркером в custom claim.
    match /tenants/{businessId}/deals/{dealId} {
      allow read: if isManager(businessId)
                  && "crmUserId" in request.auth.token
                  && resource.data.ownerId == request.auth.token.crmUserId;
    }

    // Менеджер читает конфиг воронки и метрики (нужны для экрана pipeline).
    match /tenants/{businessId}/funnels/{funnelId} {
      allow read: if isManager(businessId);
    }
    match /tenants/{businessId}/funnel_metrics/{funnelId} {
      allow read: if isManager(businessId);
    }

    // users/{uid}: пользователь читает только свой документ; запись — только серверный воркер.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // _config — публичные конфиги (тарифы и т.д.). Чтение для всех авторизованных, запись — только воркер.
    match /_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /_config/{docId}/{sub=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Всё остальное — закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
