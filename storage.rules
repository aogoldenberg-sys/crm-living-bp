rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Сотрудник Густорико — email есть в Firestore tenants/gustoriko/emailRoles (как в firestore.rules).
    function isGustorikoEmployee() {
      return request.auth != null
          && request.auth.token.email != null
          && firestore.exists(/databases/(default)/documents/tenants/gustoriko/emailRoles/$(request.auth.token.email));
    }

    // Договоры и прайсы поставщиков (SupplierModal). Удаление — только через консоль.
    match /suppliers/{supId}/{file} {
      allow read: if isGustorikoEmployee();
      allow create, update: if isGustorikoEmployee()
          && request.resource.size < 25 * 1024 * 1024;
    }

    // Старые загрузки SupplierModal до переноса в suppliers/{supId}/ — только чтение.
    match /uploads/{file} {
      allow read: if isGustorikoEmployee();
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
