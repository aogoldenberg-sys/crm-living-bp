{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@crm/ai-kit": ["../../../packages/ai-kit/src/index.ts"],
      "@crm/core": ["../../../packages/core/src/index.ts"],
      "@crm/schemas": ["../../../packages/schemas/src/index.ts"],
      "@crm/firestore-adapter": ["../../../packages/firestore-adapter/src/index.ts"]
    }
  },
  "include": ["src"]
}
